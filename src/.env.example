APP_NAME="radiopipe"
APP_ENV="local"
APP_KEY=
APP_DEBUG=true
APP_URL="http://localhost:8080"

APP_LOCALE="en"
APP_FALLBACK_LOCALE="en"
APP_FAKER_LOCALE="en_US"

APP_MAINTENANCE_DRIVER="file"
# APP_MAINTENANCE_STORE="database"

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL="stderr"
LOG_STACK="stderr"
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL="debug"

DB_CONNECTION="mysql"
DB_HOST="mysql"
DB_PORT=3306
DB_DATABASE="radiopipe"
DB_USERNAME="radiopipe"
DB_PASSWORD="radiopipe"

SESSION_DRIVER="redis"
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH="/"
SESSION_DOMAIN=null

BROADCAST_CONNECTION="log"
FILESYSTEM_DISK="s3"
QUEUE_CONNECTION="database"

CACHE_STORE="redis"
# CACHE_PREFIX=

MEMCACHED_HOST="127.0.0.1"

REDIS_CLIENT="phpredis"
REDIS_HOST="valkey"
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER="log"
MAIL_SCHEME=null
MAIL_HOST="127.0.0.1"
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
AWS_DEFAULT_REGION="us-east-1"
AWS_BUCKET="radiopipe-local"
AWS_ENDPOINT="http://minio:9000"
AWS_URL="http://localhost:9000/radiopipe-local"
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

OPENAI_API_KEY=
OPENAI_MODEL="gpt-5.4-mini"
OPENAI_REQUEST_TIMEOUT=60
OPENAI_MAX_RETRIES=2

RADIOPIPE_UPSTREAM_PROVIDER="fake"
RADIOPIPE_UPSTREAM_URL=
RADIOPIPE_UPSTREAM_KEY=
RADIOPIPE_UPSTREAM_REQUEST_TIMEOUT=30
RADIOPIPE_UPSTREAM_MAX_RETRIES=2
RADIOPIPE_UPSTREAM_DEFAULT_WINDOW_HOURS=24
RADIOPIPE_UPSTREAM_DEFAULT_LIMIT=100

RADIOPIPE_WEATHER_PROVIDER="fake"
RADIOPIPE_WEATHER_REQUEST_TIMEOUT=10
RADIOPIPE_WEATHER_MAX_RETRIES=2
RADIOPIPE_OPEN_METEO_BASE_URL="https://api.open-meteo.com"
RADIOPIPE_WEATHER_DEFAULT_LATITUDE=
RADIOPIPE_WEATHER_DEFAULT_LONGITUDE=
RADIOPIPE_WEATHER_DEFAULT_LOCATION_NAME=
RADIOPIPE_WEATHER_DEFAULT_TIMEZONE="Asia/Tokyo"

RADIOPIPE_NEWS_PROVIDER="fake"
RADIOPIPE_NEWS_REQUEST_TIMEOUT=10
RADIOPIPE_NEWS_MAX_RETRIES=2
RADIOPIPE_NEWSAPI_BASE_URL="https://newsapi.org"
RADIOPIPE_NEWSAPI_KEY=
RADIOPIPE_NEWSAPI_COUNTRY="jp"
RADIOPIPE_NEWSAPI_CATEGORY="general"
RADIOPIPE_NEWSAPI_LANGUAGE="ja"
RADIOPIPE_NEWSAPI_PAGE_SIZE=20
RADIOPIPE_NEWSAPI_SOURCES=
RADIOPIPE_RSS_FEEDS=

RADIOPIPE_TOPIC_EDITORIAL_ANALYZER="fake"
RADIOPIPE_TOPIC_EDITORIAL_MODEL="gpt-5.4-mini"

RADIOPIPE_SCENARIO_GENERATOR="fake"
RADIOPIPE_SCENARIO_MODEL="gpt-5.4-mini"
RADIOPIPE_SCENARIO_MAX_TOPICS=5
RADIOPIPE_SCENARIO_TARGET_SECONDS=900

RADIOPIPE_PIPELINE_SCHEDULE_ENABLED=false
RADIOPIPE_PIPELINE_INTERVAL_MINUTES=10
RADIOPIPE_PIPELINE_TIMEZONE=Asia/Tokyo
RADIOPIPE_PIPELINE_LIMIT=20
RADIOPIPE_PIPELINE_CHARACTER=
RADIOPIPE_TOPIC_NOMINATION_THROTTLE_SECONDS=3600

RADIOPIPE_AI_DRIVER="fake"
RADIOPIPE_RUNDOWN_MODEL="gpt-5.4-mini"
RADIOPIPE_SCRIPT_MODEL="gpt-5.4-mini"
RADIOPIPE_SCRIPT_BATCH_LIMIT=10
RADIOPIPE_SCRIPT_DAILY_LIMIT=100
RADIOPIPE_SCRIPT_TARGET_MINUTES=15
RADIOPIPE_SCRIPT_OUTPUT_SCHEMA_VERSION=1.0

RADIOPIPE_ADMIN_ALLOWED_EMAILS=

RADIOPIPE_ADMIN_DEV_LOGIN_ENABLED=false
RADIOPIPE_ADMIN_DEV_LOGIN_EMAIL=
